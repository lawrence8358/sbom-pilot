{
  "manifestVersion": 1,
  "id": "sbom-pilot",
  "name": "SBOM Pilot",
  "publisher": "LawrenceShen",
  "repository": {
    "type": "git",
    "uri": "https://github.com/lawrence8358/sbom-pilot"
  },
  "version": "0.3.0",
  "description": "產生 CycloneDX SBOM 的單一 Azure Pipelines Task。",
  "public": false,
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "categories": [
    "Azure Pipelines"
  ],
  "icons": {
    "default": "images/extension-icon.png"
  },
  "content": {
    "details": {
      "path": "README.md"
    },
    "license": {
      "path": "LICENSE"
    }
  },
  "files": [
    {
      "path": "dist"
    },
    {
      "path": "README.md",
      "addressable": true
    },
    {
      "path": "images/extension-icon.png",
      "addressable": true
    }
  ],
  "contributions": [
    {
      "id": "sbom-pilot",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "dist"
      }
    }
  ]
}
