{
  "manifestVersion": 1,
  "id": "sbom-pilot",
  "name": "SBOM Pilot",
  "publisher": "LawrenceShen",
  "repository": { "type": "git", "uri": "https://github.com/lawrence8358/sbom-pilot" },
  "version": "0.1.2",
  "description": "產生 CycloneDX SBOM 的單一 Azure Pipelines Task。",
  "public": false,
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "categories": [
    "Azure Pipelines"
  ],
  "icons": { "default": "images/extension-icon.png" },
  "content": {
    "details": {
      "path": "marketplace/overview.md"
    },
    "license": {
      "path": "LICENSE"
    }
  },
  "files": [
    {
      "path": "dist"
    },
    { "path": "README.md", "addressable": true },
    { "path": "marketplace", "addressable": true },
    { "path": "images", "addressable": true },
    { "path": "docs/marketplace.md", "addressable": true },
    {
      "path": "THIRD-PARTY-NOTICES.md"
    },
    {
      "path": "docs/framework.md",
      "addressable": true
    },
    { "path": "docs/package-managers.md", "addressable": true },
    { "path": "docs/yarn.md", "addressable": true },
    { "path": "docs/combined.md", "addressable": true },
    { "path": "docs/npm-auth.md", "addressable": true },
    { "path": "docs/nuget-auth.md", "addressable": true },
    { "path": "docs/compatibility.md", "addressable": true },
    { "path": "README-Dev.md", "addressable": true },
    { "path": "CHANGELOG.md", "addressable": true },
    { "path": "examples", "addressable": true },
    { "path": "scripts/docker/combined.Dockerfile", "addressable": true
    }
  ],
  "contributions": [
    {
      "id": "sbom-pilot",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "dist"
      }
    }
  ]
}
