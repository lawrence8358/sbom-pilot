{
  "manifestVersion": 1,
  "id": "sbom-pilot",
  "name": "SBOM Pilot",
  "publisher": "LawrenceShen",
  "repository": {
    "type": "git",
    "uri": "https://github.com/lawrence8358/sbom-pilot"
  },
  "version": "0.3.4",
  "description": "產生 CycloneDX SBOM 的單一 Azure Pipelines Task。",
  "public": false,
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "categories": [
    "Azure Pipelines"
  ],
  "scopes": [
    "vso.build"
  ],
  "icons": {
    "default": "images/extension-icon.png"
  },
  "content": {
    "details": {
      "path": "README.md"
    },
    "license": {
      "path": "LICENSE"
    }
  },
  "files": [
    {
      "path": "dist/osv-tab",
      "addressable": true
    },
    {
      "path": "dist"
    },
    {
      "path": "README.md",
      "addressable": true
    },
    {
      "path": "images/extension-icon.png",
      "addressable": true
    }
  ],
  "contributions": [
    {
      "id": "sbom-pilot",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "dist"
      }
    },
    {
      "id": "osv-report-tab",
      "type": "ms.vss-build-web.build-results-tab",
      "targets": [
        "ms.vss-build-web.build-results-view"
      ],
      "properties": {
        "name": "OSV 弱點報告",
        "uri": "dist/osv-tab/index.html",
        "supportsTasks": [
          "ae7d525c-a209-48e5-8f3e-17b24500b7b5"
        ]
      }
    }
  ]
}
