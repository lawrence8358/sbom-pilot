{
  "name": "sbom-pilot",
  "version": "0.1.0",
  "private": true,
  "description": "SBOM Pilot Azure Pipelines task",
  "author": "Lawrence Shen",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "package:dev": "npm run build && node scripts/package.mjs --local",
    "package:release": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "ajv-formats-draft2019": "1.6.1",
    "azure-pipelines-task-lib": "5.282.0",
    "azure-pipelines-tool-lib": "2.281.0",
    "jsonc-parser": "3.3.1",
    "semver": "7.7.4"
  },
  "devDependencies": {
    "@types/node": "20.19.33",
    "@types/semver": "7.7.1",
    "esbuild": "0.27.4",
    "tfx-cli": "0.23.1",
    "typescript": "5.9.3"
  }
}
